# ─── footiq.ir Production Config ──────────────────────
# Copy this file to .env and fill in the values

# Database (SQL Server)
DB_CONNECTION_STRING=Server=YOUR_SERVER;Database=footdb;User ID=YOUR_USER;Password=YOUR_PASSWORD;TrustServerCertificate=True

# Redis
REDIS_CONNECTION_STRING=YOUR_REDIS_HOST:6379,password=YOUR_REDIS_PASSWORD

# JWT (generate a strong 32+ char key)
JWT_KEY=YourSuperSecretKeyHereMustBe32CharactersLong!!

# ZarinPal Payment Gateway
ZARINPAL_MERCHANT_ID=YOUR_MERCHANT_ID

# AI Service (Arvan Cloud / DeepSeek)
AI_BASE_URL=YOUR_AI_BASE_URL
AI_API_KEY=YOUR_AI_API_KEY
