<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS Application Host Config for footiq.ir
  This configures IIS as reverse proxy for api.footiq.ir → localhost:8080
  
  Install URL Rewrite Module first:
  https://www.iis.net/downloads/microsoft/url-rewrite
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!-- Reverse Proxy: api.footiq.ir → localhost:8080 -->
        <rule name="API Reverse Proxy" stopProcessing="true">
          <match url="^api/(.*)" />
          <action type="Rewrite" url="http://localhost:8080/{R:1}" />
          <serverVariables>
            <set name="HTTP_X_FORWARDED_HOST" value="{HTTP_HOST}" />
            <set name="HTTP_X_FORWARDED_PROTO" value="https" />
            <set name="HTTP_X_FORWARDED_FOR" value="{REMOTE_ADDR}" />
          </serverVariables>
        </rule>
      </rules>
      <outboundRules>
        <!-- Rewrite Location header for API responses -->
        <rule name="Fix API Location Header" preCondition="IsAPI">
          <match serverVariable="RESPONSE_Location" pattern="^http://localhost:8080/(.*)" />
          <action type="Rewrite" value="https://api.footiq.ir/{R:1}" />
        </rule>
        <preConditions>
          <preCondition name="IsAPI">
            <add input="{HTTP_HOST}" pattern="api\.footiq\.ir" />
          </preCondition>
        </preConditions>
      </outboundRules>
    </rewrite>
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-XSS-Protection" value="1; mode=block" />
        <add name="Strict-Transport-Security" value="max-age=31536000; includeSubDomains" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
